# credentials - never commit
.env
.env.*
!.env.example

# run artifacts - keep baseline cache only
runs/*
!runs/demo_baseline/
!runs/demo_baseline/**

# backups and temp
runs_backup/
*.bak

# environment and caches
.venv/
__pycache__/
*.pyc
.pytest_cache/

# editor - allow settings.json only
.vscode/*
!.vscode/settings.json

# large files - use shared drive
data/full/
*.zip
*.mp4